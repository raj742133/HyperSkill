# Runtime environment: development | test | production. Defaults to production (Secure cookies, HSTS) when unset.
NODE_ENV=production
# Port the server listens on
PORT=3000
# Secret used to sign session cookies. REQUIRED. At least 32 random characters. Never commit the real value.
SESSION_SECRET=
# Interface to listen on. 127.0.0.1 by default; set 0.0.0.0 inside a container.
HOST=127.0.0.1
# How many proxies sit in front of the app (0 = none). Wrong values break per-IP rate limits: 0 if exposed directly, 1 behind one platform proxy.
TRUST_PROXY=0
# Rate limits (per process). Signup per IP per hour; login per IP+email and per IP, per 15 minutes.
SIGNUP_LIMIT_PER_HOUR=10
LOGIN_LIMIT_PER_15MIN=10
LOGIN_IP_LIMIT_PER_15MIN=100
# SQLite file path. Use :memory: for tests. In production use a persistent path.
DB_PATH=./data/duesoon.db
# debug | info | warn | error
LOG_LEVEL=info
