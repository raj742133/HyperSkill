#!/usr/bin/env bash
# Enable with:  git config core.hooksPath examples/duesoon/.githooks   (run from the repository root)
set -euo pipefail
root=$(git rev-parse --show-toplevel)
cd "$root/examples/duesoon"
staged=$(git diff --cached --name-only --diff-filter=ACM | sed "s#^#$root/#")
if [[ -n "$staged" ]]; then
  # shellcheck disable=SC2086
  bash scripts/secret-scan.sh $staged || { echo "pre-commit: possible secret staged, commit blocked"; exit 1; }
fi
npm run --silent lint
