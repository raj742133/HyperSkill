{
  "name": "duesoon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5 <23"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning src/server.js",
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.js",
    "lint": "node --check src/server.js && node --check src/app.js && node --check src/routes/index.js && node --check src/services/assignments.js && node --check src/services/users.js && node --check src/middleware/security.js && node --check public/app.js && node --check public/due.js",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.js",
    "test:e2e": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 e2e/*.e2e.js",
    "mutation": "node --disable-warning=ExperimentalWarning scripts/mutation-check.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "playwright-core": "^1.64.1"
  }
}
