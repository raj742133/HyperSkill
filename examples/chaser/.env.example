# Port the server listens on
PORT=3000
# Interface to listen on. 127.0.0.1 unless a container or proxy needs 0.0.0.0
HOST=127.0.0.1
# Secret for GET /api/stats and the ?op= switch that stops counting your own visits. REQUIRED, at least 24 random characters. Never commit the real value.
OPERATOR_TOKEN=
# Directory for the counter and waitlist files. Must be on persistent disk in production.
DATA_DIR=./data
# Comma-separated list of allowed traffic-source tags (the ?src= values), for example me,friends,community,post
ALLOWED_SRC=me,friends,community,post
# development | production. Production adds HSTS.
NODE_ENV=production
